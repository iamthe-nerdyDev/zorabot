generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String      @id @default(cuid())
  fid                        String?     @unique
  address                    String      @unique
  name                       String?
  farcasterNotificationUrl   String?
  farcasterNotificationToken String?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  metadata                   Json?
  
  alerts                     Alert[]
  watchlists                 Watchlist[]
  createdMarkets             PriceMarket[] @relation("CreatedMarkets")
  shares                     Shares[]      @relation("UserShares")
  claims                     Claim[]      @relation("UserClaims")

  @@map("users")
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  alerts    Alert[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId], map: "watchlist_userId_fkey")
  @@map("watchlist")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  coinAddress String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, coinAddress])
  @@map("watchlist_items")
}

model Alert {
  id          String      @id @default(cuid())
  userId      String
  coinAddress String?
  status      AlertStatus @default(ENABLED)
  note        String?
  condition   Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  watchlistId String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist   Watchlist?  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([userId], map: "alerts_userId_fkey")
  @@index([watchlistId], map: "alerts_watchlistId_fkey")
  @@map("alerts")
}

enum AlertStatus {
  ENABLED
  DISABLED
}

enum MarketOutcome {
  UNRESOLVED
  YES
  NO
}

model PriceMarket {
  id                       String        @id @default(cuid())
  onchain_id               Int           @unique
  tokenAddress             String
  creatorAddress           String
  bettingTokenAddress      String
  targetPrice              String
  targetIsAboveTargetPrice Boolean
  outcome                  MarketOutcome @default(UNRESOLVED)
  endTs                    DateTime
  totalYesShares           String
  totalNoShares            String
  resolved                 Boolean
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  token         Token @relation("Token", fields: [tokenAddress], references: [address], onDelete: Restrict)
  bettingToken  Token @relation("BettingToken", fields: [bettingTokenAddress], references: [address], onDelete: Restrict)
  creator       User  @relation("CreatedMarkets", fields: [creatorAddress], references: [address], onDelete: Restrict)

  shares Shares[]
  claims Claim[]

  @@map("priceMarkets")
  @@index([tokenAddress])
  @@index([creatorAddress])
}

model Token {
  id            String    @id @default(cuid())
  address       String    @unique
  name          String
  symbol        String
  description   String
  icon          String
  decimals      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  marketsUsingAsToken        PriceMarket[] @relation("Token")
  marketsUsingAsBettingToken PriceMarket[] @relation("BettingToken")
  
  @@map("tokens")
}

model Shares {
  id          String      @id @default(cuid())
  marketId    String
  userAddress String
  isYes       Boolean
  amount      String
  feeAmount   String      @default("0")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  market PriceMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user   User        @relation("UserShares", fields: [userAddress], references: [address], onDelete: Restrict)

  @@map("shares")
  @@index([userAddress])
}

model Claim {
  id          String      @id @default(cuid())
  marketId    String
  userAddress String
  amount      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  market PriceMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user   User        @relation("UserClaims", fields: [userAddress], references: [address], onDelete: Restrict)

  @@map("claims")
  @@index([marketId])
  @@index([userAddress])
  @@unique([marketId, userAddress]) 
}

model Creator {
  id      String @id @default(cuid())
  address String @unique
  admin   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
