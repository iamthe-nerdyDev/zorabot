generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String      @id @default(cuid())
  fid                        String?     @unique
  address                    String      @unique
  farcasterNotificationUrl   String?
  farcasterNotificationToken String?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  metadata                   Json?
  alerts                     Alert[]
  watchlists                 Watchlist[]

  @@map("users")
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  alerts    Alert[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId], map: "watchlist_userId_fkey")
  @@map("watchlist")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  coinAddress String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, coinAddress])
  @@map("watchlist_items")
}

model Alert {
  id          String      @id @default(cuid())
  userId      String
  coinAddress String?
  status      AlertStatus @default(ENABLED)
  note        String?
  condition   Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  watchlistId String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist   Watchlist?  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([userId], map: "alerts_userId_fkey")
  @@index([watchlistId], map: "alerts_watchlistId_fkey")
  @@map("alerts")
}

enum AlertStatus {
  ENABLED
  DISABLED
}
